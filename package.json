{
  "name": "casa-2-studio",
  "version": "1.0.0",
  "description": "",
  "main": "electron/main.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "electron": "electron .",
    "dist": "prisma generate && electron-builder"
  },
  "build": {
    "appId": "com.casa2studio.agenda",
    "productName": "Agenda Casa 2 Studio",
    "directories": {
      "output": "release2",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "server.js",
      "package.json",
      "src/backend/**/*",
      "src/frontend/**/*",
      "node_modules/.prisma/**/*"
    ],
    "asarUnpack": [
      "node_modules/@prisma/client/**/*",
      "node_modules/.prisma/**/*"
    ],
    "extraResources": [
      {
        "from": "build-resources/studio.template.db",
        "to": "studio.template.db"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "shortcutName": "Agenda Casa 2 Studio"
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "prisma": "^6.19.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
