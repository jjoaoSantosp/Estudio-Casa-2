generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Agendamento {
  id String @id @default(uuid())
  nomeBanda String
  horaInicio DateTime
  horaFim DateTime
  valor Int
  createdAt DateTime @default(now())

  @@index([horaInicio])
}